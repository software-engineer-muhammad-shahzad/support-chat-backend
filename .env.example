# Copy to .env and fill in real values.

# Database. Leave unset to use local SQLite (db.sqlite3).
# Supabase example — use the Transaction pooler (port 6543), not Session
# mode (5432, only 15 slots): a web app doing many short requests exhausts
# that fast.
# DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# SMTP — used for password-reset emails. Leave EMAIL_HOST_PASSWORD blank to
# fall back to the console backend (prints emails to the terminal) in DEBUG.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Where the frontend runs — used to build the password-reset link in the email.
FRONTEND_URL=http://localhost:3000

# Redis — channel layer + online/offline presence tracking, and Celery's
# task result backend. Leave unset to use a local Redis on the default
# port, or use a free Upstash database
# (console.upstash.com -> Redis -> Create -> Connect -> TCP tab):
# REDIS_URL=rediss://default:PASSWORD@your-db-name.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379/0

# Celery's broker (the queue it dispatches background tasks through) — a
# free CloudAMQP (RabbitMQ) instance works well: console.cloudamqp.com ->
# Create instance -> "Little Lemur" (free) -> Details -> AMQP URL. Leave
# unset and Celery falls back to using REDIS_URL above as the broker too.
# CELERY_BROKER_URL=amqps://user:PASSWORD@host.rmq.cloudamqp.com/vhost
CELERY_BROKER_URL=

# Gemini — embeddings + answer generation. Get a key at aistudio.google.com/apikey.
GEMINI_API_KEY=

# Cohere — reranks retrieved chunks against the question before they go to
# Gemini. Get a key at dashboard.cohere.com -> API Keys.
COHERE_API_KEY=

# OCR.space — text extraction for scanned PDFs (no embedded text layer).
# Get a free key at ocr.space/ocrapi (1MB/file, first 3 pages of a PDF).
OCR_SPACE_API_KEY=
