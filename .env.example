# Copy to .env and fill in real values.

# Database. Leave unset to use local SQLite (db.sqlite3).
# Supabase example:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# SMTP — used for password-reset emails. Leave EMAIL_HOST_PASSWORD blank to
# fall back to the console backend (prints emails to the terminal) in DEBUG.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Where the frontend runs — used to build the password-reset link in the email.
FRONTEND_URL=http://localhost:3000
